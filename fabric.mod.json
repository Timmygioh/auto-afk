{
	"schemaVersion": 1,
	"id": "autoafk",
	"version": "${version}",
	"name": "AutoAfk",
	"description": "Sendet automatisch alle 10 Minuten /afk.",
	"authors": [
		"Timmygioh"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/autoafk/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.example.autoafk.AutoAfk"
		],
		"client": [
			"de.example.autoafk.client.AutoAfkClient"
		]
	},
	"mixins": [
		"autoafk.mixins.json",
		{
			"config": "autoafk.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}